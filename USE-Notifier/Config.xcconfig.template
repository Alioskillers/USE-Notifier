// Better Stack SQL/ClickHouse HTTP Connection Credentials
BETTERSTACK_HOST = YOUR-REGION-connect.betterstackdata.com
BETTERSTACK_USERNAME = YOUR_CLICKHOUSE_USERNAME
BETTERSTACK_PASSWORD = YOUR_CLICKHOUSE_PASSWORD

// Your source table name (format: tXXXXXX_source_name_logs)
// You can find this in Better Stack → Integrations → SQL section
BETTERSTACK_SOURCE_TABLE = tXXXXXX_your_source_logs
